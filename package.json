{
  "name": "dsh-sidebrowser",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "DSH 官方侧边栏浏览器：结构化观察、原生输入、页面开发诊断与操作后复核。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/features.js",
    "src/debug-schema.js",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "plugin-settings.js",
    "settings-ui.js",
    "scripts/build-settings.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check src/features.js",
    "build": "node scripts/build.mjs && npm run build:settings",
    "build:settings": "node scripts/build-settings.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "happy-dom": "^21.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsakuraAOI/dsh-sidebrowser.git"
  },
  "homepage": "https://github.com/AsakuraAOI/dsh-sidebrowser#readme",
  "bugs": {
    "url": "https://github.com/AsakuraAOI/dsh-sidebrowser/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "pluginPage": {
    "name": "dsh-sidebrowser",
    "title": "侧边栏浏览器",
    "route": "/api/plugins/dsh-sidebrowser/settings",
    "titles": {
      "kasumi-retry": "Kasumi 重试与续写",
      "hiagent-global": "Kasumi 全局适配",
      "hiagent-global-compaction": "全局压缩",
      "hiagent-observability": "性能观测",
      "hiagent-recovery": "恢复保护",
      "hiagent-query-budget": "请求预算",
      "bilibili-account": "B站账号与视频阅读",
      "hiagent-web-search": "网页搜索与读取",
      "seeit-video": "Seeit 视频理解",
      "session-md-export": "导出选项",
      "kasumiflow": "学习事务与课程资料"
    }
  }
}
